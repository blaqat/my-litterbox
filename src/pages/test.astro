---
import Layout from "@layouts/MainLayout.astro";
import TestComponent from "@components/test.svelte";
---

<Layout>
  <article class="prose max-w-none prose-blue">
    <h1 class="text-2xl font-bold mb-2">Aiden's Astro Playground</h1>
    <p class="mb-4">
      This is a playground for me to test out features and components. Check out
      the other pages to see what I've been working on!
    </p>
    <p class="mb-4">
      You can find the source code for this site on <a
        href="https://github.com/blaqat/my-litterbox">GitHub</a
      >.
    </p>
  </article>
  {
    /** Hydrate on client so svelte/reactivity MediaQuery can evaluate viewport */
  }
  <TestComponent client:only="svelte" />
</Layout>
