---
import catKnife from "@assets/cat-knife.png";
import Layout from "../layouts/Layout.astro";
import Overlay from "@components/TextOverlay.svelte";
---

<head>
  <title>404 Not Found</title>
</head>

<Layout>
  <body class="m-0 font-mono">
    <main class="flex flex-col items-center justify-center h-screen w-screen">
      <img
        src={catKnife.src}
        alt="Cat with a knife"
        width="250px"
        class="hover:-rotate-8 transition"
      />
      <h2 class="font-sans text-2xl font-bold mt-[1rem] text-gray-900">
        ermm... return from whereth you came :)
      </h2>
      <h3 class="text-lg text-gray-600 mt-3 font-bold">
        404 - this page does not exist...
      </h3>
      <Overlay label="go away " color="text-yellow-700/5" />
    </main>
  </body>
</Layout>
