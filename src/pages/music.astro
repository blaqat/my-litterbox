---
import Layout from "../layouts/MainLayout.astro";
import music from "../data/music.json";
import MusicList from "@components/Music/MusicList.svelte";
import SearchableList from "@components/Music/SearchableList.svelte";
import MusicModal from "@components/Music/MusicModal.svelte";
---

<Layout pageTitle="Music">
  <div class="max-w-3xl mx-auto w-full">
    <SearchableList client:load items={music} />
  </div>

  <MusicModal client:load />
</Layout>
