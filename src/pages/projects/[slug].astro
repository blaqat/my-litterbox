---
import Layout from "../../layouts/MainLayout.astro";
import SEO from "@components/SEO.astro";
import ProjectsPage from "../../components/Projects/ProjectsPage.svelte";
import ProjectModal from "../../components/Projects/ProjectModal.svelte";
import projects from "../../data/projects.json";
import { parseProjects } from "../../components/Projects/ProjectData";

const parsed = parseProjects(JSON.stringify(projects));
const { slug } = Astro.params;
const project = parsed.find((p) => p.slug === slug);
const firstShareable = project?.images?.find((img) =>
  /\.(png|jpe?g|webp|gif|svg)(\?|$)/i.test(img.src)
);
const socialImage = firstShareable?.src ?? "/favicon.svg";
const exists = Boolean(project);
if (!exists) {
  return Astro.redirect("/projects");
}
---

<Layout wide>
  <Fragment slot="head">
    <SEO
      title={`${project!.name} • Projects • blaqat`}
      description={project!.description}
      image={socialImage}
      type="article"
    />
  </Fragment>
  <ProjectsPage client:load projects={parsed} />
  <ProjectModal client:load />
  <noscript>
    <p>
      Project details require JavaScript. View all projects <a href="/projects"
        >here</a
      >.
    </p>
  </noscript>
</Layout>
