---
import blaqatLogo from "@assets/blaqat.svg";
import navigationItems from "@data/NavigationItems";
import Overlay from "@components/TextOverlay.svelte";
---

<main class="flex items-center justify-center w-screen h-screen flex-col">
  <div id="background-overlays" class="w-full h-full absolute -z-5">
    <div
      class="absolute top-0 left-0 w-1/3 h-1/3 bg-sea-pink-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute top-0 right-0 w-1/3 h-1/3 bg-light-wisteria-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-malibu-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-1/3 h-1/3 bg-harvest-gold-300 opacity-40 blur-[120px] rounded-full"
    >
    </div>
  </div>

  <div
    class="bg-slate-50/40 flex flex-col items-center border-2 border-slate-200 p-25 rounded-[100px] shadow-2xl shadow-slate-400"
  >
    <img src={blaqatLogo.src} alt="cat logo" class="w-24 h-24 -mb-1" />
    <span class="text-3xl font-bold font-serif">blaqat / aiden</span>

    <hr class="border-t-gray-300 my-4 w-full" />
    <div id="navigation-buttons" class="grid grid-cols-2 gap-5 prose">
      {
        navigationItems.map((item) => {
          return (
            <a
              href={item.href}
              class={`px-9 py-3 bg-gray-200 rounded ${item.hover} transition ${item.color} text-center ${item.text} hover:scale-110 active:scale-95 font-semibold`}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</main>
