---
import blaqatLogo from "@assets/blaqat.svg";
import navigationItems from "@data/NavigationItems";
import Desktop from "@components/DeviceType/Desktop.svelte";
import Mobile from "@components/DeviceType/Mobile.svelte";
import { Content as AboutMe } from "@data/aboutme.md";
import Header from "@components/Header.svelte";
---

<main class="min-h-screen w-screen overflow-x-hidden relative">
  <div id="background-overlays" class="w-full h-full fixed top-0 left-0 -z-5">
    <div
      class="absolute top-0 left-0 w-1/3 h-1/3 bg-sea-pink-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute top-0 right-0 w-1/3 h-1/3 bg-malibu-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-light-wisteria-400 opacity-40 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-1/3 h-1/3 bg-harvest-gold-300 opacity-40 blur-[120px] rounded-full"
    >
    </div>
  </div>

  <Desktop>
    <div class="flex min-h-screen justify-center items-start py-8">
      <div
        class="bg-slate-50/40 flex flex-col items-center border-2 border-slate-200 p-8 shadow-2xl shadow-slate-400 max-w-3xl w-full mx-4 rounded"
      >
        <img src={blaqatLogo.src} alt="cat logo" class="w-24 h-24 -mb-1" />
        <span class="text-3xl font-bold font-serif">blaqat / aiden</span>
        <hr class="border-t-gray-300 my-4 w-full" />
        <div
          id="navigation-buttons"
          class="flex flex-wrap gap-3 justif y-center px-4"
        >
          {
            navigationItems.map((item) => (
              <a
                href={item.href}
                class={`inline-flex items-center gap-2 px-8 py-3 rounded-lg transition ${item.hover} ${item.color} font-semibold`}
              >
                {item.label}
              </a>
            ))
          }
        </div>

        <hr class="border-t-gray-300 my-4 w-full" />

        <div
          class="prose prose-sm md:prose max-w-none px-6 [&_h1]:font-serif [&_h2]:font-serif [&_h3]:font-serif [&_ul]:space-y-1 [&_li]:mb-0"
        >
          <AboutMe />
        </div>
      </div>
    </div>
  </Desktop>

  <Mobile>
    <div class="min-h-screen pt-3 pb-40">
      <div class="flex flex-col items-center px-4">
        <img src={blaqatLogo.src} alt="cat logo" class="w-24 h-24 -mb-1" />
        <span class="text-3xl font-bold font-serif mt-2">blaqat / aiden</span>

        <hr class="border-t-gray-100 my-4 w-full" />
        <Header client:only />

        <div
          class="prose prose-sm max-w-none px-4 [&_h1]:font-serif [&_h2]:font-serif [&_h3]:font-serif [&_ul]:space-y-1 [&_li]:mb-0"
        >
          <AboutMe />
        </div>
      </div>
    </div>
  </Mobile>
</main>
