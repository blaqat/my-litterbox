---
import blaqatLogo from "@assets/blaqat.svg";
import nina from "@assets/nina.jpg";
import HomeNav from "@components/HomeNav.svelte";
import HomeLangs from "@components/HomeLangs.svelte";
import Mobile from "@components/DeviceType/Mobile.svelte";
import Desktop from "@components/DeviceType/Desktop.svelte";
import Header from "@components/Header.svelte";
---

<main
  class="min-h-screen w-full overflow-x-hidden relative flex flex-col items-center justify-center py-16 px-4"
>
  <!-- Animated background blobs -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div
      class="blob blob-1 absolute rounded-full bg-sea-pink-400 opacity-30 blur-[120px]"
      style="width: 52%; height: 52%; top: -14%; left: -8%;"
    >
    </div>
    <div
      class="blob blob-2 absolute rounded-full bg-malibu-400 opacity-30 blur-[120px]"
      style="width: 46%; height: 46%; top: -8%; right: -12%;"
    >
    </div>
    <div
      class="blob blob-3 absolute rounded-full bg-light-wisteria-400 opacity-30 blur-[120px]"
      style="width: 42%; height: 42%; bottom: -12%; left: -6%;"
    >
    </div>
    <div
      class="blob blob-4 absolute rounded-full bg-harvest-gold-300 opacity-30 blur-[120px]"
      style="width: 48%; height: 48%; bottom: -8%; right: -8%;"
    >
    </div>
  </div>

  <!-- Hero -->
  <div class="flex flex-col items-center text-center w-full max-w-lg">
    <!-- Cat with bobbing animation -->
    <a href="https://www.instagram.com/lisaauditart/"
      ><div class="cat-bob mb-3">
        <img
          src={nina.src}
          alt="blaqat cat"
          class="w-30 drop-shadow-lg select-none rotate-[2deg] crop-bottom rounded-full outline outline-6 outline-slate-900"
          draggable="false"
        />
      </div></a
    >

    <h1
      class="text-3xl font-bold font-serif text-slate-800 tracking-tight mb-1"
    >
      blaqat.net
    </h1>
    <p class="text-sm text-slate-500 italic mb-7">that's "black cat"</p>

    <!-- 4 intro lines -->
    <div
      class="space-y-3 text-slate-700 text-base md:text-[17px] leading-relaxed mb-10 max-w-[45rem]"
    >
      <p>
        hi, i'm <strong class="text-slate-900">aiden</strong>! a
        <span class="relative inline-block group/se">
          <span
            class="text-xs absolute -top-3 left-1/2 -translate-x-1/2 italic rotate-[-4deg] text-malibu-400 opacity-0 group-hover/se:opacity-100 transition duration-150 whitespace-nowrap pointer-events-none"
            >nerrrrrddd</span
          >
          <a
            href="/projects"
            class="squiggle squiggle-blue font-medium hover:text-malibu-800 transition duration-150 hover:font-bold"
            >software engineer</a
          >
        </span>
        with a soft spot for ui design
      </p>
      <p>
        recent
        <span class="relative inline-block group/rit">
          <span
            class="text-xs absolute -top-3 left-1/2 -translate-x-1/2 italic rotate-[5deg] text-orange-300 opacity-0 group-hover/rit:opacity-100 transition duration-150 whitespace-nowrap pointer-events-none"
            >go tigers!</span
          >
          <a
            href="https://www.rit.edu"
            class="squiggle squiggle-orange font-medium hover:text-orange-800 transition duration-150 hover:font-bold"
            >RIT</a
          >
        </span>
        grad, fluent in <HomeLangs client:load /> and more
      </p>
      <p>
        away from screens, i'm
        <span class="relative inline-block group/comp">
          <span
            class="text-xs absolute -top-2.5 left-1/2 -translate-x-1/2 italic rotate-[-3deg] text-light-wisteria-400 opacity-0 group-hover/comp:opacity-100 transition duration-150 whitespace-nowrap pointer-events-none"
            >♫⋆｡♪ ₊˚♬ ﾟ.</span
          >
          <a
            href="/music"
            class="squiggle squiggle-purple font-medium hover:text-light-wisteria-800 transition duration-150 hover:font-bold"
            >composing</a
          >
        </span>
        for piano, film, and games
      </p>
    </div>

    <!-- Decorative divider -->
    <div class="flex items-center gap-3 w-full max-w-xs mb-5 text-slate-300">
      <div class="flex-1 h-px bg-slate-200"></div>
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        class="text-slate-300 shrink-0"
      >
        <circle cx="10" cy="10" r="3" fill="currentColor"></circle>
        <circle cx="3" cy="10" r="2" fill="currentColor" opacity="0.5"></circle>
        <circle cx="17" cy="10" r="2" fill="currentColor" opacity="0.5"
        ></circle>
      </svg>
      <div class="flex-1 h-px bg-slate-200"></div>
    </div>

    <!-- Nav cards -->
    <HomeNav class="mb-10" />
    <span class="mb-7"></span>
  </div>
</main>

<style>
  /* Blob drift animations */
  .blob-1 {
    animation: drift1 14s ease-in-out infinite alternate;
  }
  .blob-2 {
    animation: drift2 18s ease-in-out infinite alternate;
  }
  .blob-3 {
    animation: drift3 12s ease-in-out infinite alternate;
  }
  .blob-4 {
    animation: drift4 16s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    from {
      transform: translate(0%, 0%) scale(1);
    }
    to {
      transform: translate(7%, 9%) scale(1.12);
    }
  }
  @keyframes drift2 {
    from {
      transform: translate(0%, 0%) scale(1.05);
    }
    to {
      transform: translate(-7%, 7%) scale(0.94);
    }
  }
  @keyframes drift3 {
    from {
      transform: translate(0%, 0%) scale(1);
    }
    to {
      transform: translate(9%, -9%) scale(1.1);
    }
  }
  @keyframes drift4 {
    from {
      transform: translate(0%, 0%) scale(1.04);
    }
    to {
      transform: translate(-6%, -7%) scale(0.92);
    }
  }

  /* Gentle cat bob */
  .cat-bob {
    animation: catBob 4s ease-in-out infinite;
    transform-origin: center bottom;
  }
  @keyframes catBob {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  /* Squiggly keyword underlines */
  .squiggle {
    text-decoration: underline wavy;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .squiggle-pink {
    text-decoration-color: var(--color-sea-pink-400);
  }
  .squiggle-blue {
    text-decoration-color: var(--color-malibu-400);
  }
  .squiggle-purple {
    text-decoration-color: var(--color-light-wisteria-500);
  }
  .squiggle-gold {
    text-decoration-color: var(--color-harvest-gold-400);
  }
  .squiggle-orange {
    text-decoration-color: #fb923c;
  }
</style>
