---
import { ClientRouter, fade } from "astro:transitions";
import "../styles/global.css";
import Header from "@components/Header.svelte";
import Player from "@components/Music/Player.svelte";
import SEO from "@components/SEO.astro";
import { Device } from "@lib/device.svelte";

export interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={pageTitle ? `${pageTitle} • blaqat` : "blaqat's litterbox"}
      image="/favicon.svg"
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <ClientRouter />
    <Header client:only />
    <div id="background-overlays" class="w-full h-full fixed top-0 left-0 -z-5">
      <div
        class="absolute top-0 left-0 w-1/3 h-1/3 bg-sea-pink-400 opacity-12 blur-[120px] rounded-full"
      >
      </div>
      <div
        class="absolute top-0 right-0 w-1/3 h-1/3 bg-malibu-400 opacity-12 blur-[120px] rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-light-wisteria-400 opacity-12 blur-[120px] rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-1/3 h-1/3 bg-harvest-gold-300 opacity-12 blur-[120px] rounded-full"
      >
      </div>
    </div>
    <Player client:only desktop={Device.gt_sm} />
    <main class="flex-1 p-6 max-w-4xl mx-auto">
      {pageTitle && <h1 class="text-2xl font-bold mb-4">{pageTitle}</h1>}
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0px;
    width: 100%;
    height: 100%;
  }
</style>
